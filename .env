# URL base de la API (Alineado con el /v1 del backend)
VITE_API_URL=http://localhost:5000/api/v1

# Próximo módulo: URL para Métricas en Tiempo Real (WebSockets)
VITE_WS_URL=ws://localhost:5000 

# Configuración general de la app (Opcional por si quieres cambiarlo fácil)
VITE_APP_NAME="Sistema de Gestión Misionera"
VITE_API_TIMEOUT=10000

# Control de logs (Para apagar los console.log en producción si lo deseas)
VITE_ENABLE_LOGS=true


