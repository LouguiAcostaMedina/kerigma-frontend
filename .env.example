# ===== SGM Frontend - Variables de entorno =====
# Copia este archivo a `.env` y ajusta los valores. Nunca commitees `.env`.

# URL base de la API
VITE_API_URL=http://localhost:5000/api/v1

# URL del WebSocket (notificaciones en tiempo real)
VITE_WS_URL=ws://localhost:5000

# Nombre de la aplicación
VITE_APP_NAME="Sistema de Gestión Misionera"

# Timeout de peticiones (ms)
VITE_API_TIMEOUT=10000

# Habilita logs de la consola
VITE_ENABLE_LOGS=true
